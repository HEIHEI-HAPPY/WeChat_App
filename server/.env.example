# 微信小程序凭证（绝不能进代码库）
WX_APPID=your_wx_appid_here
WX_SECRET=your_wx_secret_here

# JWT 签名密钥（生成一个长随机串，比如：my-mall-2026-secret-key）
JWT_SECRET=please-change-me-to-a-long-random-string-min-32-chars

# MinIO 配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000/mall
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mall

# 数据库（生产用）
DB_USER=mall
DB_PASSWORD=mall_pwd