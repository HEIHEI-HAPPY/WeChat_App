/* components/goods-card/goods-card.wxss */
.card {
  display: flex;
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.cover {
  width: 200rpx;
  height: 200rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}
.body {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price {
  font-size: 32rpx;
  color: #6F4E37;
  font-weight: 600;
}