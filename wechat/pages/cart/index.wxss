/* pages/cart/index.wxss */
.loading, .empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
}
.empty-emoji { font-size: 120rpx; }
.empty-text { margin: 24rpx 0 40rpx; font-size: 28rpx; }
.btn-go {
  background: #6F4E37 !important;
  color: #FFF !important;
  border-radius: 48rpx !important;
  width: 320rpx;
  font-size: 28rpx !important;
}

.list {
  padding: 20rpx 24rpx 200rpx;
}
.cart-item {
  display: flex;
  background: #FFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}
.body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.name { font-size: 30rpx; font-weight: 600; }
.sku {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price { font-size: 30rpx; color: #6F4E37; font-weight: 600; }

.qty-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5F5F5;
  text-align: center;
  line-height: 44rpx;
  font-size: 32rpx;
}
.qty-num { min-width: 60rpx; text-align: center; font-size: 28rpx; }
.del {
  margin-left: auto;
  font-size: 26rpx;
  color: #C00;
  padding: 8rpx 16rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFF;
  border-top: 1rpx solid #EEE;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.total { font-size: 28rpx; color: #333; }
.total-num { color: #6F4E37; font-weight: 700; font-size: 36rpx; }
.btn-row { display: flex; gap: 16rpx; }
.btn-clear, .btn-checkout {
  padding: 20rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
}
.btn-clear {
  background: #F5F5F5;
  color: #666;
}
.btn-checkout {
  background: linear-gradient(135deg, #6F4E37, #8B6F4E);
  color: #FFF;
}