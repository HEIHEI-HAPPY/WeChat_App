<!--pages/order/detail/index.wxml-->
<view wx:if="{{!order}}" class="loading">加载中...</view>

<block wx:else>
  <!-- 状态头 -->
  <view class="status-bar status-{{order.status}}">
    <view class="status-title">{{statusText}}</view>
    <view class="status-hint">{{statusHint}}</view>
  </view>

  <!-- 收货地址 -->
  <view wx:if="{{order.address}}" class="addr-block">
    <view class="row1">
      <text class="name">{{order.address.name}}</text>
      <text class="phone">{{order.address.phone}}</text>
    </view>
    <view class="row2">
      {{order.address.province || ''}}{{order.address.city || ''}}{{order.address.district || ''}} {{order.address.detail}}
    </view>
    <view wx:if="{{order.pickupType === 1}}" class="pickup-tag">到店自取</view>
    <view wx:elif="{{order.pickupType === 2}}" class="pickup-tag">外卖配送</view>
  </view>

  <!-- 商品列表 -->
  <view class="section">
    <view class="section-title">商品 ({{order.items.length}})</view>
    <view wx:for="{{order.items}}" wx:key="id" class="goods-line">
      <text class="line-name">{{item.goodsName || '商品 #' + item.goodsId}}</text>
      <text class="line-qty">×{{item.quantity}}</text>
      <text class="line-price">￥{{item.priceSnapshot / 100}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view wx:if="{{order.remark}}" class="section">
    <view class="section-title">备注</view>
    <view class="remark-text">{{order.remark}}</view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <view class="info-row"><text class="info-label">订单号</text><text class="info-value mono">{{order.orderNo}}</text></view>
    <view class="info-row"><text class="info-label">下单时间</text><text class="info-value">{{order.createdAt}}</text></view>
    <view wx:if="{{order.paidAt}}" class="info-row"><text class="info-label">支付时间</text><text class="info-value">{{order.paidAt}}</text></view>
    <view wx:if="{{order.transactionId}}" class="info-row"><text class="info-label">交易号</text><text class="info-value mono">{{order.transactionId}}</text></view>
    <view class="info-row total-row"><text class="info-label">实付</text><text class="info-value total">{{totalYuan}}</text></view>
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{order.status === 0}}" class="footer">
    <view class="btn-cancel" bindtap="onCancel">取消订单</view>
    <view class="btn-pay" bindtap="onPay">立即支付</view>
  </view>
</block>