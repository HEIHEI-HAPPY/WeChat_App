<!--pages/order/confirm/index.wxml-->
<view wx:if="{{loading}}" class="loading">加载中...</view>

<block wx:elif="{{items.length === 0}}">
  <view class="empty">
    <view class="empty-emoji">🛒</view>
    <view class="empty-text">购物车空空如也</view>
    <button class="btn-go" bindtap="goShop">去购物</button>
  </view>
</block>

<block wx:else>
  <!-- 地址选择区 -->
  <view class="addr-block" bindtap="onPickAddress">
    <view wx:if="{{selectedAddress}}" class="addr-selected">
      <view class="addr-row1">
        <text class="name">{{selectedAddress.name}}</text>
        <text class="phone">{{selectedAddress.phone}}</text>
        <text wx:if="{{selectedAddress.isDefault}}" class="default-tag">默认</text>
      </view>
      <view class="addr-row2">
        {{selectedAddress.province || ''}}{{selectedAddress.city || ''}}{{selectedAddress.district || ''}} {{selectedAddress.detail}}
      </view>
    </view>
    <view wx:else class="addr-empty">
      <text>+ 请选择收货地址</text>
    </view>
    <view class="arrow">›</view>
  </view>

  <!-- 商品列表 -->
  <view class="section">
    <view class="section-title">商品 ({{items.length}})</view>
    <view wx:for="{{items}}" wx:key="itemId" class="goods-row">
      <image class="cover" src="{{item.imageUrl || '/images/placeholder.png'}}" mode="aspectFill"></image>
      <view class="body">
        <view class="name">{{item.goodsName}}</view>
        <view class="sku">{{item.sku}}</view>
        <view class="row-bottom">
          <text class="price">{{ itemYuan[item.itemId] }}</text>
          <text class="qty">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 自取 / 外卖 -->
  <view class="section">
    <view class="section-title">取餐方式</view>
    <radio-group bindchange="onPickupChange" class="radio-group">
      <label class="radio">
        <radio value="1" checked="{{pickupType === 1}}" color="#6F4E37" />到店自取
      </label>
      <label class="radio">
        <radio value="2" checked="{{pickupType === 2}}" color="#6F4E37" />外卖配送
      </label>
    </radio-group>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注</view>
    <textarea class="remark" placeholder="选填，可写口味/送达时间等" maxlength="120" value="{{remark}}" bindinput="onRemarkInput"></textarea>
  </view>

  <!-- 底部固定栏 -->
  <view class="footer">
    <view class="total">合计 <text class="total-num">{{totalYuan}}</text></view>
    <button class="btn-submit" bindtap="onSubmit" disabled="{{submitting}}">提交订单</button>
  </view>
</block>