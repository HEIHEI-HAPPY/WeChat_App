/* pages/goods/detail/index.wxss */
.loading {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

.hero {
  background: #FFF;
  padding: 32rpx;
}
.cover {
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
}
.info-body { padding: 24rpx 0 0; }
.name { font-size: 36rpx; font-weight: 600; color: #333; }
.desc { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.price { font-size: 40rpx; color: #6F4E37; font-weight: 700; margin-top: 16rpx; }

.spec-block {
  background: #FFF;
  margin-top: 20rpx;
  padding: 32rpx;
}
.spec-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}
.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.spec-chip {
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  background: #F5F5F5;
  color: #333;
  font-size: 26rpx;
}
.spec-chip.active {
  background: #6F4E37;
  color: #FFF;
}
.spec-chip .extra {
  font-size: 22rpx;
  margin-left: 8rpx;
  opacity: 0.8;
}

.qty-block {
  background: #FFF;
  margin-top: 20rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.qty-label { font-size: 28rpx; color: #666; }
.qty-control { display: flex; align-items: center; }
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  text-align: center;
  line-height: 52rpx;
  font-size: 36rpx;
  color: #333;
}
.qty-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 32rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFF;
  border-top: 1rpx solid #EEE;
  padding: 16rpx;
  box-sizing: border-box;
}
.footer-cart {
  width: 96rpx;
  text-align: center;
  font-size: 48rpx;
  line-height: 80rpx;
}
.btn-add, .btn-buy {
  flex: 1;
  margin: 0 8rpx;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 48rpx;
  font-size: 30rpx;
}
.btn-add {
  background: linear-gradient(135deg, #FFC8A0, #FFA060);
  color: #FFF;
}
.btn-buy {
  background: linear-gradient(135deg, #6F4E37, #8B6F4E);
  color: #FFF;
}