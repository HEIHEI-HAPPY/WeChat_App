<!--pages/goods/detail/index.wxml-->
<view wx:if="{{loading}}" class="loading">加载中...</view>

<block wx:elif="{{goods}}">
  <!-- 商品头图 + 信息 -->
  <view class="hero">
    <image class="cover" src="{{goods.imageUrl || '/images/placeholder.png'}}" mode="aspectFill"></image>
    <view class="info-body">
      <view class="name">{{goods.name }}</view>
      <view class="desc">{{goods.description || '香浓咖啡，欢迎品尝'}}</view>
      <view class="price">{{ totalYuan }}</view>
    </view>
  </view>

  <!-- 规格选择区 -->
  <view wx:for="{{specs}}" wx:key="name" wx:for-item="spec" class="spec-block">
    <view class="spec-title">{{spec.name}}</view>
    <view class="spec-options">
      <view
        wx:for="{{spec.options}}"
        wx:key="label"
        wx:for-item="opt"
        class="spec-chip {{ selected[spec.name] === opt.label ? 'active' : '' }}"
        data-spec-name="{{spec.name}}"
        data-value="{{opt.label}}"
        data-extra-price="{{opt.extraPrice || 0}}"
        bindtap="onSelectSpec"
      >
        {{opt.label}}
        <text wx:if="{{opt.extraPrice}}" class="extra">+￥{{opt.extraPrice / 100}}</text>
      </view>
    </view>
  </view>

  <!-- 数量 -->
  <view class="qty-block">
    <text class="qty-label">数量</text>
    <view class="qty-control">
      <view class="qty-btn" bindtap="onMinus">−</view>
      <text class="qty-num">{{quantity}}</text>
      <view class="qty-btn" bindtap="onPlus">+</view>
    </view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="footer">
    <view class="footer-cart" bindtap="goCart">🛒</view>
    <view class="btn-add" bindtap="onAddCart">加入购物车</view>
    <view class="btn-buy" bindtap="onBuyNow">立即购买</view>
  </view>
</block>